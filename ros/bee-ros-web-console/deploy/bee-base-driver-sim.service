[Unit]
Description=Bee base driver against virtual STM32 (manual test only)
After=bee-virtual-stm32.service
Wants=bee-virtual-stm32.service

[Service]
Type=simple
User=sunrise
Group=sunrise
Environment=ROS_DOMAIN_ID=0
ExecStart=/opt/bee-ros-web-console/deploy/start-base-driver-sim.sh
Restart=on-failure
RestartSec=1
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
