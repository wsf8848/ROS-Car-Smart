[Unit]
Description=Bee ROS Web Console Simulation Layers (manual test only)
After=bee-web-console.service

[Service]
Type=simple
User=sunrise
Group=sunrise
Environment=ROS_DOMAIN_ID=0
ExecStart=/opt/bee-ros-web-console/deploy/start-sim-layers.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
